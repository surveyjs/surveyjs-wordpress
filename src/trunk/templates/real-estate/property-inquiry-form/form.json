{
  "title": "Property Inquiry Form",
  "description": "Tell us what you're looking for and an agent will get back to you with matching properties or next steps.",
  "showQuestionNumbers": "off",
  "showProgressBar": true,
  "questionErrorLocation": "bottom",
  "completeText": "Send inquiry",
  "widthMode": "static",
  "width": "760px",
  "pages": [
    {
      "name": "yourInterest",
      "title": "Your Interest",
      "elements": [
        {
          "type": "radiogroup",
          "name": "inquiryType",
          "title": "I'm looking to...",
          "isRequired": true,
          "colCount": 4,
          "choices": [
            { "value": "buy", "text": "Buy" },
            { "value": "rent", "text": "Rent" },
            { "value": "sell", "text": "Sell" },
            { "value": "invest", "text": "Invest" }
          ]
        },
        {
          "type": "text",
          "name": "propertyReference",
          "title": "Listing ID or property address",
          "description": "Optional. If you're asking about a specific listing, enter its reference here.",
          "maxLength": 120
        },
        {
          "type": "checkbox",
          "name": "propertyType",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Property type",
          "isRequired": true,
          "colCount": 3,
          "choices": [
            { "value": "apartment", "text": "Apartment" },
            { "value": "house", "text": "House" },
            { "value": "townhouse", "text": "Townhouse" },
            { "value": "condo", "text": "Condo" },
            { "value": "land", "text": "Land" },
            { "value": "commercial", "text": "Commercial" }
          ]
        },
        {
          "type": "dropdown",
          "name": "bedrooms",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Minimum bedrooms",
          "choices": [
            { "value": "studio", "text": "Studio" },
            { "value": "1", "text": "1" },
            { "value": "2", "text": "2" },
            { "value": "3", "text": "3" },
            { "value": "4-plus", "text": "4+" }
          ]
        },
        {
          "type": "dropdown",
          "name": "bathrooms",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Minimum bathrooms",
          "startWithNewLine": false,
          "choices": [
            { "value": "1", "text": "1" },
            { "value": "1-5", "text": "1.5" },
            { "value": "2", "text": "2" },
            { "value": "3-plus", "text": "3+" }
          ]
        },
        {
          "type": "panel",
          "name": "budget",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Budget",
          "elements": [
            {
              "type": "text",
              "name": "priceMin",
              "visibleIf": "{inquiryType} anyof ['buy', 'invest']",
              "title": "Minimum price ($)",
              "inputType": "number",
              "min": 0,
              "step": 1000
            },
            {
              "type": "text",
              "name": "priceMax",
              "visibleIf": "{inquiryType} anyof ['buy', 'invest']",
              "title": "Maximum price ($)",
              "isRequired": true,
              "startWithNewLine": false,
              "inputType": "number",
              "min": 0,
              "step": 1000,
              "validators": [
                {
                  "type": "expression",
                  "expression": "{priceMin} empty or {priceMax} >= {priceMin}",
                  "text": "The maximum price can't be lower than the minimum."
                }
              ]
            },
            {
              "type": "text",
              "name": "monthlyRentMax",
              "visibleIf": "{inquiryType} = 'rent'",
              "title": "Maximum monthly rent ($)",
              "isRequired": true,
              "inputType": "number",
              "min": 0,
              "step": 50
            }
          ]
        },
        {
          "type": "text",
          "name": "preferredAreas",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Preferred neighborhoods or areas",
          "placeholder": "For example, Downtown, Riverside, or within 30 minutes of the city center",
          "maxLength": 200
        },
        {
          "type": "checkbox",
          "name": "mustHaves",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Must-haves",
          "colCount": 3,
          "choices": [
            { "value": "parking", "text": "Parking" },
            { "value": "garden", "text": "Garden or yard" },
            { "value": "pet-friendly", "text": "Pet-friendly" },
            { "value": "furnished", "text": "Furnished" },
            { "value": "elevator", "text": "Elevator" },
            { "value": "balcony", "text": "Balcony" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "timeline",
          "title": "What's your timeline?",
          "isRequired": true,
          "colCount": 2,
          "choices": [
            { "value": "asap", "text": "As soon as possible" },
            { "value": "1-3-months", "text": "Within 1–3 months" },
            { "value": "3-6-months", "text": "Within 3–6 months" },
            { "value": "browsing", "text": "Just browsing for now" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "financingStatus",
          "visibleIf": "{inquiryType} = 'buy'",
          "title": "Financing status",
          "choices": [
            { "value": "pre-approved", "text": "Pre-approved for a mortgage" },
            { "value": "need-advice", "text": "I need mortgage advice" },
            { "value": "cash-buyer", "text": "Cash buyer" }
          ]
        },
        {
          "type": "panel",
          "name": "currentHome",
          "visibleIf": "{inquiryType} = 'sell'",
          "title": "About the property you're selling",
          "elements": [
            {
              "type": "text",
              "name": "currentHomeAddress",
              "title": "Property address",
              "isRequired": true,
              "autocomplete": "street-address"
            },
            {
              "type": "text",
              "name": "estimatedValue",
              "title": "Estimated value ($)",
              "description": "Your best guess is fine. We'll provide a free valuation.",
              "inputType": "number",
              "min": 0,
              "step": 1000
            },
            {
              "type": "comment",
              "name": "reasonForSelling",
              "title": "Why are you selling?",
              "rows": 2,
              "maxLength": 500
            }
          ]
        }
      ]
    },
    {
      "name": "contactDetails",
      "title": "Contact Details",
      "elements": [
        {
          "type": "text",
          "name": "firstName",
          "title": "First name",
          "isRequired": true,
          "autocomplete": "given-name"
        },
        {
          "type": "text",
          "name": "lastName",
          "title": "Last name",
          "isRequired": true,
          "startWithNewLine": false,
          "autocomplete": "family-name"
        },
        {
          "type": "text",
          "name": "email",
          "title": "Email",
          "isRequired": true,
          "inputType": "email",
          "autocomplete": "email",
          "validators": [
            { "type": "email" }
          ]
        },
        {
          "type": "text",
          "name": "phone",
          "title": "Phone",
          "isRequired": true,
          "startWithNewLine": false,
          "inputType": "tel",
          "autocomplete": "tel"
        },
        {
          "type": "radiogroup",
          "name": "preferredContactMethod",
          "title": "Preferred contact method",
          "colCount": 3,
          "choices": [
            { "value": "email", "text": "Email" },
            { "value": "phone", "text": "Phone call" },
            { "value": "text", "text": "Text message" }
          ]
        },
        {
          "type": "radiogroup",
          "name": "viewingPreference",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "How would you like to view properties?",
          "colCount": 3,
          "choices": [
            { "value": "in-person", "text": "In person" },
            { "value": "video-tour", "text": "Video tour" },
            { "value": "either", "text": "Either works" }
          ]
        },
        {
          "type": "checkbox",
          "name": "preferredViewingTimes",
          "visibleIf": "{inquiryType} anyof ['buy', 'rent', 'invest']",
          "title": "Preferred viewing times",
          "colCount": 2,
          "choices": [
            { "value": "weekday-daytime", "text": "Weekdays during the day" },
            { "value": "weekday-evenings", "text": "Weekday evenings" },
            { "value": "saturday", "text": "Saturdays" },
            { "value": "sunday", "text": "Sundays" }
          ]
        },
        {
          "type": "comment",
          "name": "message",
          "title": "Anything else we should know?",
          "rows": 3,
          "maxLength": 1000
        },
        {
          "type": "boolean",
          "name": "marketingConsent",
          "title": "Send me new listings and market updates that match my criteria",
          "description": "You can unsubscribe at any time.",
          "labelTrue": "Yes, please",
          "labelFalse": "No, thanks"
        }
      ]
    }
  ],
  "completedHtml": "<h3>Thank you, {firstName}!</h3><p>Your inquiry has been sent to our team. An agent will contact you at <b>{email}</b> or <b>{phone}</b> within one business day.</p>",
  "completedHtmlOnCondition": [
    {
      "expression": "{inquiryType} = 'sell'",
      "html": "<h3>Thank you, {firstName}!</h3><p>An agent will contact you at <b>{email}</b> or <b>{phone}</b> within one business day to arrange a free valuation of <b>{currentHomeAddress}</b>.</p>"
    }
  ]
}
