{
  "title": "Background check consent form",
  "pages": [
    {
      "name": "personalDetails",
      "elements": [
        {
          "type": "panel",
          "name": "partAPanel",
          "elements": [
            {
              "type": "text",
              "name": "surname",
              "title": "Surname",
              "maxLength": 35
            },
            {
              "type": "text",
              "name": "surnameAtBirth",
              "startWithNewLine": false,
              "title": "Surname at birth",
              "maxLength": 35
            },
            {
              "type": "matrixdynamic",
              "name": "fullGivenNames",
              "title": "Full given names",
              "description": "(no initials; circle name normally used)",
              "descriptionLocation": "underTitle",
              "showHeader": false,
              "columns": [
                {
                  "name": "givenNamesMatrix",
                  "cellType": "text",
                  "isUnique": true
                }
              ],
              "rowCount": 1,
              "confirmDelete": true,
              "confirmDeleteText": "Are you sure you want to delete this name?",
              "addRowText": "Add another name"
            },
            {
              "type": "matrixdynamic",
              "name": "otherNames",
              "startWithNewLine": false,
              "title": "All other names used",
              "description": "(e.g. nickname, pseudonym, married name)",
              "descriptionLocation": "underTitle",
              "showHeader": false,
              "columns": [
                {
                  "name": "otherNamesMatrix",
                  "cellType": "text",
                  "isUnique": true
                }
              ],
              "rowCount": 1,
              "confirmDelete": true,
              "confirmDeleteText": "Are you sure you want to delete this name?",
              "addRowText": "Add another name"
            },
            {
              "type": "text",
              "name": "nameChange",
              "title": "Name change",
              "description": "(other than by marriage)",
              "descriptionLocation": "underInput",
              "maxLength": 35
            },
            {
              "type": "multipletext",
              "name": "datePlace",
              "startWithNewLine": false,
              "title": "Date and place of name change",
              "items": [
                {
                  "name": "date",
                  "inputType": "date",
                  "title": "Date",
                  "validators": [
                    {
                      "type": "expression",
                      "text": "The date of name change must be after the date of birth.",
                      "expression": "{datePlace.date} > {dob}"
                    }
                  ]
                },
                {
                  "name": "place",
                  "placeholder": "(city, province/state, country)",
                  "title": "Place"
                }
              ],
              "itemTitleWidth": "45"
            },
            {
              "type": "text",
              "name": "dob",
              "title": "Date of Birth",
              "validators": [
                {
                  "type": "expression",
                  "text": "You must be at least 18 years old to submit the form.",
                  "expression": "age({dob}) >= 18"
                }
              ],
              "inputType": "date"
            },
            {
              "type": "text",
              "name": "placeOfBirth",
              "startWithNewLine": false,
              "title": "Place of Birth",
              "description": "(city, province or state, and country)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "radiogroup",
              "name": "gender",
              "maxWidth": "50%",
              "title": "Gender",
              "commentText": "Other (describe)",
              "choices": [
                {
                  "value": "female",
                  "text": "Female"
                },
                {
                  "value": "male",
                  "text": "Male"
                },
                {
                  "value": "other",
                  "text": "Other"
                }
              ],
              "otherText": "Other (please specify)",
              "otherErrorText": "Response required: please specify your gender.",
              "colCount": 3
            },
            {
              "type": "text",
              "name": "specifyGender",
              "visibleIf": "{gender} = 'other'",
              "startWithNewLine": false,
              "title": "Please specify your gender"
            },
            {
              "type": "text",
              "name": "socialInsuranceNumber",
              "title": "Social Insurance Number",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "999999999"
              }
            },
            {
              "type": "text",
              "name": "personalBusinessRegNumber",
              "startWithNewLine": false,
              "title": "Business Registration Number",
              "description": "(if applicable)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "matrixdynamic",
              "name": "telNumbers",
              "title": "All telephone numbers used to reach me",
              "description": "(home, work, cottage, cell, etc.)",
              "descriptionLocation": "underTitle",
              "showHeader": false,
              "columns": [
                {
                  "name": "telNumbersMatrix",
                  "cellType": "text",
                  "isUnique": true
                }
              ],
              "rowCount": 1,
              "confirmDelete": true,
              "confirmDeleteText": "Are you sure you want to delete this number?",
              "addRowText": "Add another number"
            },
            {
              "type": "matrixdynamic",
              "name": "emailAddresses",
              "startWithNewLine": false,
              "title": "All email addresses used to reach me",
              "description": "(personal and work)",
              "descriptionLocation": "underTitle",
              "showHeader": false,
              "columns": [
                {
                  "name": "emailsMatrix",
                  "cellType": "text",
                  "isUnique": true
                }
              ],
              "rowCount": 1,
              "confirmDelete": true,
              "confirmDeleteText": "Are you sure you want to delete this email address?",
              "addRowText": "Add another email"
            },
            {
              "type": "radiogroup",
              "name": "civilStatus",
              "title": "Civil status",
              "choices": [
                {
                  "value": "single",
                  "text": "Single"
                },
                {
                  "value": "married",
                  "text": "Married"
                },
                {
                  "value": "partnership",
                  "text": "Common-law partnership"
                },
                {
                  "value": "separated",
                  "text": "Separated"
                },
                {
                  "value": "divorced",
                  "text": "Divorced"
                },
                {
                  "value": "widowed",
                  "text": "Widowed"
                }
              ],
              "colCount": 3
            }
          ],
          "title": "Personal Details"
        }
      ],
      "title": "Part A"
    },
    {
      "name": "partnerDetails",
      "elements": [
        {
          "type": "panel",
          "name": "partB",
          "elements": [
            {
              "type": "text",
              "name": "partnerSurname",
              "title": "Surname"
            },
            {
              "type": "text",
              "name": "partnerSurnameAtBirth",
              "startWithNewLine": false,
              "title": "Surname at birth"
            },
            {
              "type": "matrixdynamic",
              "name": "partnerFullGivenNames",
              "maxWidth": "50%",
              "title": "Full given names",
              "description": "(no initials; circle name normally used)",
              "descriptionLocation": "underTitle",
              "showHeader": false,
              "columns": [
                {
                  "name": "partnerGivenNamesMatrix",
                  "cellType": "text",
                  "isUnique": true
                }
              ],
              "rowCount": 1,
              "confirmDelete": true,
              "confirmDeleteText": "Are you sure you want to delete this name?",
              "addRowText": "Add another name"
            },
            {
              "type": "text",
              "name": "partnerNameChange",
              "title": "Name change",
              "description": "(other than by marriage)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "multipletext",
              "name": "datePlacePartner",
              "startWithNewLine": false,
              "title": "Date and place of name change",
              "items": [
                {
                  "name": "date",
                  "inputType": "date",
                  "title": "Date",
                  "validators": [
                    {
                      "type": "expression",
                      "text": "The date of name change must be after the date of birth.",
                      "expression": "{datePlacePartner.date} > {dobPartner}"
                    }
                  ]
                },
                {
                  "name": "place",
                  "placeholder": "(city, province/state, country)",
                  "title": "Place"
                }
              ],
              "itemTitleWidth": "45"
            },
            {
              "type": "text",
              "name": "dobPartner",
              "title": "Date of Birth",
              "validators": [
                {
                  "type": "expression",
                  "text": "Your partner must be at least 18 years old.",
                  "expression": "age({dobPartner}) >= 18"
                }
              ],
              "inputType": "date"
            },
            {
              "type": "text",
              "name": "partnerPlaceBirth",
              "startWithNewLine": false,
              "title": "Place of Birth",
              "description": "(city, province or state, and country)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "citizenship",
              "title": "Current citizenship(s)",
              "description": "List all countries that you are currently a citizen of. You can hold citizenship in multiple countries.",
              "descriptionLocation": "underTitle"
            },
            {
              "type": "radiogroup",
              "name": "partnerGender",
              "maxWidth": "50%",
              "title": "Gender",
              "commentText": "Other (describe)",
              "choices": [
                {
                  "value": "female",
                  "text": "Female"
                },
                {
                  "value": "male",
                  "text": "Male"
                },
                {
                  "value": "other",
                  "text": "Other"
                }
              ],
              "otherText": "Other (please specify)",
              "otherErrorText": "Response required: please specify your gender.",
              "colCount": 3
            },
            {
              "type": "text",
              "name": "partnerSpecifyGender",
              "visibleIf": "{partnerGender} = 'other'",
              "startWithNewLine": false,
              "title": "Please specify your gender"
            },
            {
              "type": "text",
              "name": "cityMarriage",
              "title": "City, province/state of marriage/common-law partnership"
            },
            {
              "type": "text",
              "name": "dateMarriage",
              "startWithNewLine": false,
              "title": "Date of marriage/common-law partnership",
              "validators": [
                {
                  "type": "expression",
                  "text": "The date of marriage must be after you and your partner turned 18.",
                  "expression": "dateDiff({dob}, {dateMarriage}, 'years') >= 18 and dateDiff({dobPartner}, {dateMarriage}, 'years') >= 18"
                }
              ],
              "inputType": "date"
            },
            {
              "type": "text",
              "name": "countryMarriage",
              "title": "Country of marriage/common-law partnership"
            },
            {
              "type": "text",
              "name": "partnerSocialInsuranceNumber",
              "title": "Social Insurance Number",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "999999999"
              }
            },
            {
              "type": "text",
              "name": "partnerBusinessRegNumber",
              "startWithNewLine": false,
              "title": "Business Registration Number",
              "description": "(if applicable)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "boolean",
              "name": "sameAddress",
              "title": "Current partner’s address is the same as candidate’s address",
              "description": "If no, please complete the below address information",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "partnerAddress",
              "visibleIf": "{sameAddress} = false",
              "title": "Address",
              "placeholder": "Street address, Apt. number (if applicable)"
            },
            {
              "type": "text",
              "name": "partnerCity",
              "visibleIf": "{sameAddress} = false",
              "title": "City"
            },
            {
              "type": "text",
              "name": "partnerProvinceState",
              "visibleIf": "{sameAddress} = false",
              "startWithNewLine": false,
              "title": "Province or State"
            },
            {
              "type": "text",
              "name": "partnerPostalCode",
              "visibleIf": "{sameAddress} = false",
              "title": "Postal Code",
              "maxLength": 10
            },
            {
              "type": "text",
              "name": "partnerCountry",
              "visibleIf": "{sameAddress} = false",
              "startWithNewLine": false,
              "title": "Country"
            },
            {
              "type": "boolean",
              "name": "previous5Years",
              "title": "Did you have other partners in the last 5 years?"
            }
          ],
          "title": "Partner Details"
        }
      ],
      "visibleIf": "{civilStatus} anyof ['married', 'partnership']",
      "title": "Part B"
    },
    {
      "name": "partC",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "previousPartners",
          "visibleIf": "{previous5Years} = true",
          "title": "Previous Partners",
          "description": "(from the last five (5) years)",
          "templateElements": [
            {
              "type": "text",
              "name": "ppSurname",
              "title": "Surname"
            },
            {
              "type": "text",
              "name": "ppFullGivenNames",
              "startWithNewLine": false,
              "title": "Full given names"
            },
            {
              "type": "text",
              "name": "ppSurnameAtBirth",
              "startWithNewLine": false,
              "title": "Surname at birth"
            },
            {
              "type": "text",
              "name": "ppDob",
              "title": "Date of Birth"
            },
            {
              "type": "text",
              "name": "ppPlaceOfBirth",
              "startWithNewLine": false,
              "title": "Place of birth",
              "titleLocation": "top",
              "description": "(city, province/state, country)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "ppCurrentCitizenships",
              "title": "Current citizenship(s)"
            }
          ],
          "panelCount": 1,
          "panelsState": "firstExpanded",
          "addPanelText": "Add another partner"
        },
        {
          "type": "paneldynamic",
          "name": "relatives",
          "title": "Please include parents, siblings, children (including stepsiblings, stepchildren, and half-siblings), and your mother-in-law and father-in-law.",
          "description": "Do not use initials",
          "templateElements": [
            {
              "type": "text",
              "name": "relativeFullName",
              "title": "Full name",
              "description": "(surname and all given names, including maiden name)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "relativeRelationship",
              "startWithNewLine": false,
              "title": "Relationship",
              "dataList": [
                "Mother",
                "Father",
                "Brother",
                "Sister",
                "Aunt",
                "Uncle",
                "Child",
                "Half-sister",
                "Half-brother",
                "Stepsister",
                "Stepbrother",
                "Mother-in-law",
                "Father-in-law",
                "Sister-in-law",
                "Brother-in-law",
                "Grandmother",
                "Grandfather",
                "Granddaughter",
                "Grandson",
                "Niece",
                "Nephew",
                "Cousin",
                "Stepmother",
                "Stepfather",
                "Daughter-in-law",
                "Son-in-law"
              ]
            },
            {
              "type": "text",
              "name": "relativePlaceOfBirth",
              "title": "Place of birth",
              "description": "(city, province or state, and country)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "relativeDateOfBirth",
              "startWithNewLine": false,
              "title": "Date of birth",
              "inputType": "date"
            },
            {
              "type": "comment",
              "name": "relativeCurrentAddress",
              "title": "Current address",
              "description": "(apt/street #, street name, city, province or state, and country)",
              "descriptionLocation": "underInput",
              "rows": 1,
              "autoGrow": true
            },
            {
              "type": "text",
              "name": "relativeDateOfDeath",
              "startWithNewLine": false,
              "title": "Date of death",
              "description": "(if applicable)",
              "descriptionLocation": "underInput",
              "inputType": "date"
            },
            {
              "type": "comment",
              "name": "relativeNameAddressEmployer",
              "title": "Name and address of employer",
              "rows": 1,
              "autoGrow": true
            },
            {
              "type": "text",
              "name": "relativeJobTitle",
              "startWithNewLine": false,
              "title": "Job title"
            }
          ],
          "templateTitle": "Relative #{panelIndex}",
          "panelCount": 3,
          "minPanelCount": 3,
          "panelsState": "firstExpanded",
          "addPanelText": "Add another relative"
        }
      ],
      "title": "Part C"
    },
    {
      "name": "partD",
      "elements": [
        {
          "type": "paneldynamic",
          "name": "addresses",
          "title": "List addresses where you have lived during the last 10 years starting with the most current.",
          "description": "(there should be no gaps in time)",
          "templateElements": [
            {
              "type": "text",
              "name": "from",
              "title": "From",
              "description": "YYYY/MM",
              "descriptionLocation": "underInput",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999/99"
              }
            },
            {
              "type": "expression",
              "name": "toPresent",
              "visibleIf": "{panelIndex} = 1",
              "startWithNewLine": false,
              "title": "To",
              "expression": "'To present'"
            },
            {
              "type": "text",
              "name": "to",
              "visibleIf": "{panelIndex} > 0",
              "startWithNewLine": false,
              "title": "To",
              "titleLocation": "top",
              "description": "YYYY/MM",
              "descriptionLocation": "underInput",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999/99"
              }
            },
            {
              "type": "text",
              "name": "telNumber",
              "startWithNewLine": false,
              "title": "Telephone number",
              "description": "(if applicable)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "apartmentNumber",
              "title": "Apartment No.",
              "description": "(if applicable)",
              "descriptionLocation": "underInput",
              "inputType": "number"
            },
            {
              "type": "comment",
              "name": "streetNameNumber",
              "startWithNewLine": false,
              "title": "Street No. and Street name",
              "descriptionLocation": "underInput",
              "rows": 1,
              "autoGrow": true
            },
            {
              "type": "text",
              "name": "city",
              "startWithNewLine": false,
              "title": "City",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "provinceState",
              "title": "Province/State"
            },
            {
              "type": "text",
              "name": "postalCode",
              "startWithNewLine": false,
              "title": "Postal Code",
              "descriptionLocation": "underInput",
              "maxLength": 10
            },
            {
              "type": "text",
              "name": "country",
              "startWithNewLine": false,
              "title": "Country",
              "descriptionLocation": "underInput"
            }
          ],
          "templateTitle": "Address #{panelIndex}",
          "panelCount": 2,
          "minPanelCount": 1,
          "panelsState": "firstExpanded",
          "addPanelText": "Add another address"
        },
        {
          "type": "boolean",
          "name": "armedForces",
          "maxWidth": "60%",
          "title": "I have served in the U.S. Armed Forces: Regular or Reserves (age 16 or older)"
        },
        {
          "type": "text",
          "name": "serviceNumber",
          "visibleIf": "{armedForces} = true",
          "maxWidth": "40%",
          "startWithNewLine": false,
          "title": "Service Number"
        }
      ],
      "title": "Part D"
    },
    {
      "name": "partE",
      "elements": [
        {
          "type": "boolean",
          "name": "employed",
          "title": "Are you currently employed?"
        },
        {
          "type": "paneldynamic",
          "name": "employment",
          "title": "List all employment over the last 10 years with no gaps.",
          "templateElements": [
            {
              "type": "text",
              "name": "employmentDate",
              "title": "From",
              "description": "YYYY/MM",
              "descriptionLocation": "underInput",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999/99"
              }
            },
            {
              "type": "text",
              "name": "employmentToPresent",
              "visibleIf": "{panelIndex} = 1 and {employed} = true",
              "startWithNewLine": false,
              "title": "To",
              "defaultValue": "To present",
              "readOnly": true
            },
            {
              "type": "text",
              "name": "employmentTo",
              "visibleIf": "{panelIndex} > 0 or {employed} = false or {employed} empty",
              "startWithNewLine": false,
              "title": "To",
              "titleLocation": "top",
              "description": "YYYY/MM",
              "descriptionLocation": "underInput",
              "maskType": "pattern",
              "maskSettings": {
                "pattern": "9999/99"
              }
            },
            {
              "type": "text",
              "name": "jobTitleDescription",
              "startWithNewLine": false,
              "title": "Job title/Description",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "employerName",
              "title": "Name of employer",
              "description": "(do not use initials)",
              "descriptionLocation": "underInput",
              "placeholder": "(department/agency/organization, if applicable)"
            },
            {
              "type": "text",
              "name": "jobSiteAddress",
              "title": "Job site address",
              "description": "(street number and street name)",
              "descriptionLocation": "underInput"
            },
            {
              "type": "text",
              "name": "jobSiteCity",
              "startWithNewLine": false,
              "title": "City"
            },
            {
              "type": "text",
              "name": "jobSiteStateProvince",
              "title": "Province/State"
            },
            {
              "type": "text",
              "name": "jobSitePostalCode",
              "startWithNewLine": false,
              "title": "Postal Code",
              "descriptionLocation": "underInput",
              "maxLength": 10
            },
            {
              "type": "text",
              "name": "jobSiteCountry",
              "startWithNewLine": false,
              "title": "Country",
              "descriptionLocation": "underInput"
            }
          ],
          "templateTitle": "Employer #{panelIndex}",
          "panelCount": 2,
          "panelsState": "firstExpanded",
          "addPanelText": "Add another employer"
        }
      ],
      "title": "Part E"
    },
    {
      "name": "partG",
      "elements": [
        {
          "type": "boolean",
          "name": "convicted",
          "title": "Have you ever been convicted of a criminal offense for which you have not been granted a pardon or a record suspension?"
        },
        {
          "type": "paneldynamic",
          "name": "offenseDetails",
          "visibleIf": "{convicted} = true",
          "title": "Please provide the following details:",
          "templateElements": [
            {
              "type": "text",
              "name": "offenseType",
              "title": "Offense"
            },
            {
              "type": "text",
              "name": "offensePoliceForce",
              "startWithNewLine": false,
              "title": "Name of police force"
            },
            {
              "type": "text",
              "name": "offenseCity",
              "startWithNewLine": false,
              "title": "City"
            },
            {
              "type": "text",
              "name": "offenseProvince",
              "title": "Province or State"
            },
            {
              "type": "text",
              "name": "offenseCountry",
              "startWithNewLine": false,
              "title": "Country"
            },
            {
              "type": "text",
              "name": "offenseConvictionDate",
              "startWithNewLine": false,
              "title": "Date of Conviction",
              "inputType": "date"
            }
          ],
          "panelCount": 1,
          "panelsState": "firstExpanded",
          "addPanelText": "Add another offense"
        },
        {
          "type": "boolean",
          "name": "charged",
          "title": "Have you ever been charged with a criminal offense for which you have not been convicted?"
        },
        {
          "type": "paneldynamic",
          "name": "chargeDetails",
          "visibleIf": "{charged} = true",
          "title": "Please provide the following details:",
          "templateElements": [
            {
              "type": "text",
              "name": "charge",
              "title": "Charge"
            },
            {
              "type": "text",
              "name": "chargePoliceForce",
              "startWithNewLine": false,
              "title": "Name of police force"
            },
            {
              "type": "text",
              "name": "chargeCity",
              "startWithNewLine": false,
              "title": "City"
            },
            {
              "type": "text",
              "name": "chargeProvinceState",
              "title": "Province or State"
