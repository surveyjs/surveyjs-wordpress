{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": "https://wordpress.org/wordpress-7.1.4.zip",
	"phpVersion": "8.3",
	"port": 9920,
	"plugins": [
		"https://downloads.wordpress.org/plugin/contact-form-7.6.2.3.zip",
		"https://downloads.wordpress.org/plugin/wpforms-lite.2.0.2.2.zip",
		"https://downloads.wordpress.org/plugin/fluentform.6.2.16.zip",
		"https://downloads.wordpress.org/plugin/ninja-forms.3.15.7.zip"
	],
	"mappings": {
		"wp-content/plugins/surveyjs": "./src/trunk",
		"wp-content/mu-plugins/sjs-e2e-mailpit.php": "./tests/e2e/mailpit.php"
	},
	"config": {
		"SCRIPT_DEBUG": false,
		"WP_DEBUG_DISPLAY": false,
		"WP_DEBUG_LOG": true,
		"SJS_E2E_SMTP_PORT": 1025,
		"WPFORMS_SETUP_WIZARD_DISABLED": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate surveyjs && wp-env run cli wp rewrite structure /%postname%/ --hard"
	}
}
