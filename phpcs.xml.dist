<?xml version="1.0"?>
<ruleset name="SurveyJS">
    <description>WordPress VIP (as the VIP Code Analysis Bot) and PHP compatibility with "Requires PHP". WordPressVIPMinimum runs separately: inside WordPress-VIP-Go some of its errors are downgraded.</description>

    <file>src/trunk</file>

    <rule ref="WordPress-VIP-Go"/>
    <rule ref="PHPCompatibilityWP"/>
    <config name="testVersion" value="8.2-"/>
    <config name="ignore_warnings_on_exit" value="1"/>

    <arg name="extensions" value="php,js"/>
    <arg name="severity" value="1"/>
    <arg name="parallel" value="8"/>
    <arg value="sp"/>

    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
